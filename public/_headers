# Security headers for every page and file of the web editor (Cloudflare reads this file).
# The page may load only its own files and may not connect anywhere else once loaded: no Postbarrel,
# no outside servers. It calls only its own /count and /write (worker/). The one outside script and
# frame is Cloudflare's Turnstile bot check on the free script writer (challenges.cloudflare.com).
# Pictures and video only from the page itself, the person's files (blob:)
# and data: images. The camera and microphone only for this page (the teleprompter).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' blob: data:; font-src 'self'; object-src 'none'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
